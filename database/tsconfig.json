{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "outDir": "./compiled",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["migrations/**/*.ts", "seeders/**/*.ts"],
  "exclude": ["compiled", "node_modules"]
}
